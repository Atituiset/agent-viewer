# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build/*
# 图标源与生成产物是打包输入，必须入库（CI checkout 需要）
!/build/icon.svg
!/build/icon.png
!/build/icons/
!/build/icon.ico
!/build/installerHeader.bmp
!/build/installerSidebar.bmp

# electron build output
/dist-electron
/release

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
